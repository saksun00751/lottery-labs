# ---------------------------------------------------------------------------
# Environment configuration
# Copy this file to `.env.local` and fill in the values for your environment.
# ---------------------------------------------------------------------------

# --- Backend API -----------------------------------------------------------
# Base URL of the backend REST API. Server-side only: the browser never sees
# this value, all traffic is relayed through /api/proxy/*.
API_BASE_URL="https://api.example.com/v1"

# Optional static key sent as `X-Api-Key` on every upstream request.
API_KEY=""

# Request timeout in milliseconds.
API_TIMEOUT_MS="15000"

# Realtime uses the same API base through server-side Route Handlers. No
# browser-visible API URL or access token is required.

# --- Authentication --------------------------------------------------------
# Which identifier the login form asks for: "username" | "phone"
NEXT_PUBLIC_LOGIN_MODE="username"

# Name of the httpOnly session cookie holding the access token.
SESSION_COOKIE_NAME="ll_session"

# Cookie lifetime in seconds (default 12h).
SESSION_MAX_AGE="43200"

# --- Site mode --------------------------------------------------------------
# Which verticals are reachable on this deployment: "lottery" | "games" | "both"
# Disabled verticals are removed from navigation AND their routes redirect to
# "/" even when hit by direct URL.
NEXT_PUBLIC_SITE_MODE="both"

# --- Localisation ----------------------------------------------------------
# Supported: th | en | my | lo | km  (comma separated, first one is default)
NEXT_PUBLIC_LOCALES="th,en,lo,km"
NEXT_PUBLIC_DEFAULT_LOCALE="th"

# --- Theming ---------------------------------------------------------------
# Available: black-gold | royal-purple | emerald-jade | ruby-noir | sapphire-ice | rose-platinum
# (enable/disable a theme in src/styles/themes/_config.scss — this list is
# just a reference, not read by the app)
NEXT_PUBLIC_DEFAULT_THEME="black-gold"

# Default colour mode: "dark" | "light" | "system"
NEXT_PUBLIC_DEFAULT_COLOR_MODE="dark"

# White chip behind the brand logo (from /meta/site) so a dark logo stays
# visible on dark themes. Set to "false" to render the logo with no backdrop.
NEXT_PUBLIC_LOGO_WHITE_BG="true"

# --- Feature flags ---------------------------------------------------------
NEXT_PUBLIC_ENABLE_REFERRAL="true"
NEXT_PUBLIC_ENABLE_PROMOTION="true"
NEXT_PUBLIC_ENABLE_DIAMOND="true"
